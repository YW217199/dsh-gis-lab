# ---------- 系统与编辑器 ----------
Thumbs.db
Desktop.ini
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# ---------- 依赖与构建产物 ----------
node_modules/
dist/
build/
.vite/

# ---------- Python（第 12 周起会用到）----------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# ---------- 环境变量与密钥（重要：高德 key 之类绝不能提交）----------
.env
.env.local
*.key
secrets.json

# ---------- 数据文件（体积大，不入库）----------
data/raw/
*.shp
*.shx
*.dbf
*.prj
*.tif
*.tiff
*.las
*.laz

# 说明：清洗后的小体积 GeoJSON 可以入库，便于 GitHub Pages 直接读取
!data/processed/*.geojson

# ---------- 日志与临时文件 ----------
*.log
*.tmp
